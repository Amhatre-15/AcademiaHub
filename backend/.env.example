# AcademiaHub Backend — Environment Variables Template
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit your actual .env file to version control.

# ─────────────────────────────────────────────────────────────────
# Database Connection (Prisma ORM)
# Compatible with Neon, Supabase, Render PostgreSQL, or local Docker.
# Use pooled connection string for DATABASE_URL and direct connection for DIRECT_URL.
# ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# ─────────────────────────────────────────────────────────────────
# Supabase (Storage, Auth, & Storage Buckets)
# Retrieve from: Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# ─────────────────────────────────────────────────────────────────
# JWT Authentication
# Use a strong random secret (minimum 64 characters recommended).
# ─────────────────────────────────────────────────────────────────
JWT_SECRET="generate-a-secure-random-64-character-secret-key-for-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─────────────────────────────────────────────────────────────────
# Server Settings
# ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ─────────────────────────────────────────────────────────────────
# Institution Settings (Initial Seed Data)
# ─────────────────────────────────────────────────────────────────
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="YourSecureAdminPassword123!"
INSTITUTION_NAME="AcademiaHub College"
INSTITUTION_TIMEZONE="Asia/Kolkata"

# ─────────────────────────────────────────────────────────────────
# Attendance Code Settings
# ─────────────────────────────────────────────────────────────────
ATTENDANCE_CODE_LENGTH=4
ATTENDANCE_CODE_EXPIRY_SECONDS=60

# ─────────────────────────────────────────────────────────────────
# File Upload Limits
# ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES="application/pdf,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png,image/gif,image/webp"

# ─────────────────────────────────────────────────────────────────
# AI (Optional)
# ─────────────────────────────────────────────────────────────────
# AI_PROVIDER="gemini"
# GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
